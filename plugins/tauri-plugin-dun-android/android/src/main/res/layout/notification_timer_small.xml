<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/timer_title" style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="12dp" />
    <Chronometer android:id="@+id/timer_countdown" style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
</LinearLayout>
