<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_background" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
    android:paddingTop="4dp" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_content" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground" android:paddingStart="4dp" android:paddingEnd="0dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Dun" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <Chronometer android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="30sp" android:textStyle="bold" android:textColor="@color/widget_ink"
                android:fontFamily="sans-serif" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                android:singleLine="true" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:visibility="gone" />
            <TextView android:id="@+id/widget_static" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/widget_ink"
                android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:singleLine="true"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="30sp" />
            <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Next due" android:textSize="12sp" android:textColor="@color/widget_muted"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_widget_settings"
            android:contentDescription="Configure countdown widget" android:padding="14dp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_actions" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="4dp">
        <Button android:id="@+id/widget_done" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="Done" android:textAllCaps="false" android:textSize="14sp" android:minWidth="0dp" android:minHeight="0dp"
            android:textColor="@color/widget_accent_text" android:backgroundTint="@color/widget_accent" />
        <Button android:id="@+id/widget_snooze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:text="+5m Snooze" android:textAllCaps="false" android:textSize="14sp" android:minWidth="0dp" android:minHeight="0dp"
            android:textColor="@color/widget_ink" android:backgroundTint="@color/widget_secondary" android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
